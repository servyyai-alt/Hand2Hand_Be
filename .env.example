NODE_ENV=development
PORT=5000
API_VERSION=v1
MONGODB_URI=mongodb://localhost:27017/hyperlocal_delivery
MONGODB_URI_TEST=mongodb://localhost:27017/hyperlocal_delivery_test
JWT_ACCESS_SECRET=your_super_secret_access_key_minimum_32_chars_long
